generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RoleKey {
  ADMIN    @map("admin")
  REVIEWER @map("reviewer")
  VIEWER   @map("viewer")
}

enum UserStatus {
  ACTIVE   @map("active")
  DISABLED @map("disabled")
}

enum TransactionDirection {
  CREDIT @map("credit")
  DEBIT  @map("debit")
}

enum ReviewState {
  NEW                  @map("new")
  SEEN                 @map("seen")
  INTERNALLY_VALIDATED @map("internally_validated")
  IGNORED              @map("ignored")
  NEEDS_REVIEW         @map("needs_review")
}

enum ScrapeRunStatus {
  QUEUED             @map("queued")
  RUNNING            @map("running")
  SUCCEEDED          @map("succeeded")
  FAILED             @map("failed")
  NEEDS_ADMIN_ACTION @map("needs_admin_action")
  THROTTLED          @map("throttled")
}

// BankSessionStatus is not referenced by any Prisma model field.
// It is kept here so that Prisma generates the enum into src/generated/prisma/enums.ts,
// giving the domain layer (src/modules/bank-sessions/) a single canonical source of
// truth for status values if it ever needs to persist them. The domain currently uses
// its own hand-rolled union type (src/modules/bank-sessions/index.ts) instead.
enum BankSessionStatus {
  ACTIVE             @map("active")
  NEEDS_ADMIN_ACTION @map("needs_admin_action")
  EXPIRED            @map("expired")
  REVOKED            @map("revoked")
}

// Change 5: Remove back-relations for reviews and auditEvents from User.
// User/Role/UserRole remain for future auth (PR9).
model User {
  id            String     @id @default(cuid())
  email         String     @unique
  displayName   String
  status        UserStatus @default(ACTIVE)
  passwordHash  String?
  roles         UserRole[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Role {
  id          String     @id @default(cuid())
  key         RoleKey    @unique
  name        String
  description String
  users       UserRole[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, roleId])
  @@index([roleId])
}

// Change 4: DROP sessions EncryptedSessionRef[] from Bank (EncryptedSessionRef model removed).
model Bank {
  id                 String                @id @default(cuid())
  code               String                @unique
  name               String
  isActive           Boolean               @default(true)
  accounts           BankAccount[]
  scrapeRuns         ScrapeRun[]
  transactions       Transaction[]
  bankCredential     BankCredential?
  autoLoginConfig    BankAutoLoginConfig?
  adapterConfig      BankAdapterConfig?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
}

model BankAccount {
  id                 String        @id @default(cuid())
  bankId             String
  bank               Bank          @relation(fields: [bankId], references: [id], onDelete: Restrict)
  accountFingerprint String
  displayName        String
  currency           String        @default("DOP")
  isActive           Boolean       @default(true)
  transactions       Transaction[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@unique([bankId, accountFingerprint])
  @@index([bankId])
}

// Change 2: Remove reviewedById/reviewedBy User relation; add plain reviewedBy String?.
model Transaction {
  id                 String               @id @default(cuid())
  bankId             String
  bank               Bank                 @relation(fields: [bankId], references: [id], onDelete: Restrict)
  accountId          String?
  account            BankAccount?         @relation(fields: [accountId], references: [id], onDelete: SetNull)
  accountFingerprint String
  postedAt           DateTime
  amount             Decimal              @db.Decimal(18, 2)
  currency           String               @default("DOP")
  direction          TransactionDirection
  reference          String?
  concept            String?
  originator         String?
  reviewState        ReviewState          @default(NEW)
  reviewedBy         String?
  reviewedAt         DateTime?
  scrapeRunId        String?
  scrapeRun          ScrapeRun?           @relation(fields: [scrapeRunId], references: [id], onDelete: SetNull)
  sourceHash         String               @unique
  metadata           Json?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([bankId, postedAt])
  @@index([accountFingerprint, postedAt])
  @@index([reviewState])
}

model ScrapeRun {
  id               String          @id @default(cuid())
  bankId           String
  bank             Bank            @relation(fields: [bankId], references: [id], onDelete: Restrict)
  status           ScrapeRunStatus @default(QUEUED)
  startedAt        DateTime?
  endedAt          DateTime?
  insertedCount    Int             @default(0)
  skippedCount     Int             @default(0)
  safeErrorSummary String?
  transactions     Transaction[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([bankId, createdAt])
  @@index([status])
}

// One unresolved expiry episode per bank code. It gives monitor replicas and
// restarts a stable event/run identity without ever storing credential material.
model BankSessionExpiryEpisode {
  bankCode                     String   @id
  expiredEventId               String   @unique
  runId                        String   @unique
  expiredAuditDeliveredAt      DateTime?
  restoredAuditDeliveredAt     DateTime?
  publicationState             String   @default("pending")
  publicationClaimToken        String?
  publicationFailureReportedAt DateTime?
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
}

// Change 4: EncryptedSessionRef model DROPPED entirely.

// Change 3: Remove actor User relation from AuditEvent; actorId/actorRole remain as plain String?.
model AuditEvent {
  id        String   @id @default(cuid())
  actorId   String?
  actorRole String?
  action    String
  target    String
  targetId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([target, targetId])
}

// PR3: Encrypted reversible credential store for bank auto-login.
// Each bankCode has exactly one credential set (two AES-256-GCM envelopes).
// The master key lives in RD_SYNC_BANK_CREDENTIAL_KEY (env/KMS), NEVER in DB.
// plaintext is decrypted ONLY in worker memory at scrape time.
model BankCredential {
  id                        String   @id @default(cuid())
  bankCode                  String   @unique
  bank                      Bank     @relation(fields: [bankCode], references: [code], onDelete: Cascade)
  encryptedUsernameEnvelope String
  encryptedPasswordEnvelope String
  keyVersion                Int      @default(1)
  isActive                  Boolean  @default(true)
  lastRotatedAt             DateTime?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
}

// PR4: Per-bank auto-login kill switch + circuit breaker state.
// autoLoginEnabled is the manual kill switch (default off).
// breakerState remains a String; the PR4.2 migration enforces closed|open only — NO half_open.
model BankAutoLoginConfig {
  id                        String    @id @default(cuid())
  bankCode                  String    @unique
  bank                      Bank      @relation(fields: [bankCode], references: [code], onDelete: Cascade)
  autoLoginEnabled          Boolean   @default(false)
  breakerState              String    @default("closed")
  breakerFailureCount       Int       @default(0)
  breakerFailureWindowStart DateTime?
  breakerOpenedAt           DateTime?
  breakerLastResetAt        DateTime?
  updatedAt                 DateTime  @updatedAt
  updatedBy                 String?
}

// PR4: Per-bank adapter kill switch (read-only scraping).
// scrapingEnabled is SEPARATE from autoLoginEnabled — disabling it
// stops ALL scraping for that bank without disabling other banks.
model BankAdapterConfig {
  id              String   @id @default(cuid())
  bankCode        String   @unique
  bank            Bank     @relation(fields: [bankCode], references: [code], onDelete: Cascade)
  scrapingEnabled Boolean  @default(true)
  updatedAt       DateTime @updatedAt
  updatedBy       String?
}
